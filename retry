(() => {
    const TARGET_PATH = "/ArcherGISSearch/default.aspx";

    const originalOpen = XMLHttpRequest.prototype.open;
    const originalSend = XMLHttpRequest.prototype.send;

    XMLHttpRequest.prototype.open = function(method, url) {
        this.__method = method;
        this.__url = url;
        return originalOpen.apply(this, arguments);
    };

    XMLHttpRequest.prototype.send = function(body) {
        this.addEventListener("readystatechange", () => {
            if (this.readyState !== 4) return;

            const url = new URL(this.__url, location.href);

            console.log(
                "[XHR]",
                this.status,
                url.href
            );

            if (
                this.status !== 500 ||
                url.pathname !== TARGET_PATH
            ) {
                return;
            }

            console.log("[XHR] 500 detected, retrying...");

            const retry = () => {
                const xhr = new XMLHttpRequest();

                xhr.open(this.__method, url.href, true);

                xhr.onreadystatechange = () => {
                    if (xhr.readyState !== 4) return;

                    console.log(
                        "[Retry]",
                        xhr.status,
                        url.href
                    );

                    if (xhr.status === 500) {
                        console.log("[Retry] 500, trying again...");
                        retry();
                    }
                };

                xhr.send(body);
            };

            retry();
        });

        return originalSend.call(this, body);
    };

    console.log("XHR retry patch installed");
})();
